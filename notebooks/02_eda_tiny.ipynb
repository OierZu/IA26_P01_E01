    "DATA = Path(\"../data_tiny\")\n",
    "tables = {f.stem: pd.read_csv(f) for f in sorted(DATA.glob(\"*.csv\"))}\n",
    "\n",
    "for name, df in tables.items():\n",
    "    print(f\"{name:25} filas={df.shape[0]:<5} columnas={df.shape[1]}\")"
